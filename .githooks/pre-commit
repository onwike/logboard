#!/bin/bash
# logboard guard: only allowlisted paths may be committed, and no staged line
# may contain a home path or a register entry heading. Local data stays local.
set -euo pipefail

ALLOW="serve.py index.html retro-tag.py test_logboard.py roots.example.json tags.example.txt README.md ROADMAP.md LICENSE .gitignore .githooks/pre-commit .githooks/pre-push .github/workflows/leak-guard.yml docs/demo-setup.png docs/demo-light.png docs/demo-dark.png"

fail=0
while IFS= read -r f; do
  ok=0
  for a in $ALLOW; do
    if [ "$f" = "$a" ]; then ok=1; break; fi
  done
  if [ "$ok" -eq 0 ]; then
    echo "pre-commit: '$f' is not on the tracked allowlist" >&2
    fail=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR)

home_pat='/Use''rs/'
entry_pat='^\+### (E|CE|C|M)[0-9]'
# grep must CONSUME all input (no -q early-exit): under `set -o pipefail` an
# early grep exit sends SIGPIPE upstream, the pipeline returns 141, and an `if`
# reads that as "no match" — a false clean on large inputs. Redirect instead.
if git diff --cached --diff-filter=ACMR --unified=0 | grep -E '^\+' | grep -E "$home_pat|$entry_pat" >/dev/null; then
  echo "pre-commit: staged content matches a home-path or register-entry pattern" >&2
  fail=1
fi

exit "$fail"
